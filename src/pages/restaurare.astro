---
import Base from '../layouts/Base.astro';
---
<Base page="restoration" titleKey="doc.title.restoration" titleText="Restoration — Claudiu Peta">
  <section class="page-head">
    <div class="eyebrow" data-i18n="nav.works">Artworks</div>
    <h1 data-i18n="sec.restoration.h2">Restoration</h1>
    <p data-i18n="sec.restoration.meta">Oil paintings · painted furniture · before &amp; after</p>
  </section>

  <section id="restoration" class="restoration">
    <div class="resto-feature">
      <img src="uploads/571032468_1400555535409844_8324277763429514244_n.jpg" alt="Oil on canvas restoration, before and after, with detail shots" />
      <p data-i18n="resto.feature">Every restoration begins with listening to the piece. This oil on canvas arrived with widespread flaking and losses; treatment meant many small repairs and consolidations, careful touch-up, and a fresh varnish — worked only as far as the painting needed, never further.</p>
    </div>

    <div class="resto-grid">
      <figure><img src="uploads/488409672_1217367293728670_7216303129947236474_n.jpg" alt="Painted folk bench, before and after restoration" /><figcaption class="caption" data-i18n="resto.bench">Painted folk bench — before &amp; after</figcaption></figure>
      <figure><img src="uploads/498119010_1253494976782568_3271441794355809778_n.jpg" alt="Hand-painted decorative floral panels in progress" /><figcaption class="caption" data-i18n="resto.floral">Folk floral panels — repainting by hand</figcaption></figure>
    </div>
  </section>
</Base>
